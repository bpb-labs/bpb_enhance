bbcode_enabled = true
bbcode_text = "[center][b]Hi everyone,
we are back with some more balance changes!
Have fun and see y’all soon! :)

- Doro and Mario
[/b][/center]
[b]Balancing[/b]
[center][b]Neutral[/b][/center]
o Holy Spear: Damage -2
o Manathirst: Lifesteal 100% -> 125%
o Serpent Staff: Poison duplication 40% -> 45%
o Moon Armor: Cooldown 2.6s -> 2.4s
o Stone Armor: Cooldown 4s -> 3.6s
o Prismatic Sword: Accuracy 90% -> 100%
o Smithing For Dummies: Stamina reduction 40% -> 45%
o Knife to Meet You: Speed per dagger 75% -> 85%
o Full Body Protection: Damage reduction 8 -> 10
o Power of the Moon: Maximum health 70% -> 75%
o Stoned: Damage as block 65% -> 70%
o Shielded: Armor speed 60% -> 65%
o Bagtacular: Potion Belt buffs 2 -> 3

[center][b]Multiclass[/b][/center]
o Spin to Win: Cooldown 3.8s -> 4.0s

[center][b]Ranger[/b][/center]
o Snowmaster: Cooldown 1.3s -> 1.4s
o Belladonna’s Whisper: Damage per poison 0.5 -> 0.6
o Critwood Staff: Duration 1.6s -> 1.8s. Bonus damage 7 -> 8
o Yggdrasil Leaf: Heal 20 -> 22

[center][b]Reaper[/b][/center]
o Frog Prince: Cooldown 2.6s -> 2.3s
o Mr. Struggles: Cooldown 3s -> 2.7s

[center][b]Pyromancer[/b][/center]
o Frozen Flame: Block 25 -> 28
o Sun Shield: Damage blocked 20 -> 22

[center][b]Berserker[/b][/center]
o Forging Hammer: Cooldown 3.5s -> 3.2s
o Chain Whip: Heal 17 -> 20
o Deerwood Guardian: Mana 4 -> 5
o Brass Knuckles: Stun chance 50% -> 55%

[center][b]Mage[/b][/center]
o Ice Flower: Block 17 -> 20
o Lantern Berry: Cooldown 2s -> 1.8s
o Devouring Sphere: Cooldown 1.4s -> 1.3s
o Rainbow Potion: Buffs per staff 7 -> 8
o Cupcake Staff: Damage +2

[center][b]Adventurer[/b][/center]
o Heart Shield: Damage blocked 20 -> 25
o Rope: Speed duration 6s -> 7s

[center][b]Engineer[/b][/center]
o Chromium Cube: Cooldown advance 1.5s -> 1.0s
o Bismuth Cube: Cooldown advance 0.2s -> 0.15s
o Plastic Cube: Cooldown advance 75%-> 65%
o Gold Cube: Cooldown advance 2s -> 1.5s
o Eat-o-matic: Other food speed boost 75% -> 85%
o Spring Loader: Speed bonus 35% -> 30%
o Con-Trap-Tron: Health threshold 70% -> 75%
o Poison Grenade: Poison 20 -> 22. Luck threshold 5 -> 3
o Chainsaw: Cooldown 1.2s -> 1.1s
o Generator: Cooldown 4.5s -> 4.2s. Stamina cost 0.8 -> 0.7
o Lightning Staff: Cooldown 1.6s -> 1.7s"
text = "Hi everyone,
we are back with some more balance changes!
Have fun and see y’all soon! :)

- Doro and Mario

Balancing
Neutral
o Holy Spear: Damage -2
o Manathirst: Lifesteal 100% -> 125%
o Serpent Staff: Poison duplication 40% -> 45%
o Moon Armor: Cooldown 2.6s -> 2.4s
o Stone Armor: Cooldown 4s -> 3.6s
o Prismatic Sword: Accuracy 90% -> 100%
o Smithing For Dummies: Stamina reduction 40% -> 45%
o Knife to Meet You: Speed per dagger 75% -> 85%
o Full Body Protection: Damage reduction 8 -> 10
o Power of the Moon: Maximum health 70% -> 75%
o Stoned: Damage as block 65% -> 70%
o Shielded: Armor speed 60% -> 65%
o Bagtacular: Potion Belt buffs 2 -> 3

Multiclass
o Spin to Win: Cooldown 3.8s -> 4.0s

Ranger
o Snowmaster: Cooldown 1.3s -> 1.4s
o Belladonna’s Whisper: Damage per poison 0.5 -> 0.6
o Critwood Staff: Duration 1.6s -> 1.8s. Bonus damage 7 -> 8
o Yggdrasil Leaf: Heal 20 -> 22

Reaper
o Frog Prince: Cooldown 2.6s -> 2.3s
o Mr. Struggles: Cooldown 3s -> 2.7s

Pyromancer
o Frozen Flame: Block 25 -> 28
o Sun Shield: Damage blocked 20 -> 22

Berserker
o Forging Hammer: Cooldown 3.5s -> 3.2s
o Chain Whip: Heal 17 -> 20
o Deerwood Guardian: Mana 4 -> 5
o Brass Knuckles: Stun chance 50% -> 55%

Mage
o Ice Flower: Block 17 -> 20
o Lantern Berry: Cooldown 2s -> 1.8s
o Devouring Sphere: Cooldown 1.4s -> 1.3s
o Rainbow Potion: Buffs per staff 7 -> 8
o Cupcake Staff: Damage +2

Adventurer
o Heart Shield: Damage blocked 20 -> 25
o Rope: Speed duration 6s -> 7s

Engineer
o Chromium Cube: Cooldown advance 1.5s -> 1.0s
o Bismuth Cube: Cooldown advance 0.2s -> 0.15s
o Plastic Cube: Cooldown advance 75%-> 65%
o Gold Cube: Cooldown advance 2s -> 1.5s
o Eat-o-matic: Other food speed boost 75% -> 85%
